new file mode 100644
index 0000000..a7dad84
--- /dev/null
+++ b/soc/qualcomm/msm8930.c
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Qualcomm MSM8930 SoC support for uniLoader.
+ * Nothing to initialise yet: the Samsung bootloader leaves clocks, GIC
+ * and the display running. Do not touch unclocked blocks - on Qualcomm an
+ * access to a gated peripheral stalls the bus.
+ */
+
+#include <soc/msm8930.h>
+
+void soc_init(void)
+{
+}

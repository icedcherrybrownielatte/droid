diff --git a/board/samsung/board-serrano3gxx.c b/board/samsung/board-serrano3gxx.c
new file mode 100644
index 0000000..80b306c
--- /dev/null
+++ b/board/samsung/board-serrano3gxx.c
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Samsung Galaxy S4 mini (GT-I9190, serrano3gxx) support for uniLoader.
+ * MSM8930AB, 540x960 MIPI DSI video panel, 1.5 GB RAM.
+ *
+ * Display: the bootloader leaves MDP4 scanning out its own framebuffer.
+ * Its address is NOT yet known (the Linux kernel framebuffer at
+ * 0x822bd000 is allocated later and is invalid here), so CONFIG_XNU_FB_BASE
+ * defaults to 0 and no console device is registered until it is found.
+ * Panel pitch is 2176 bytes (544 px), so the logical width is 544.
+ */
+
+#include <board.h>
+#include <util.h>
+#include <stdint.h>
+#include <string.h>
+#include <drivers/framework.h>
+#include <lib/simplefb.h>
+#include <lib/debug.h>
+#include <soc/msm8930.h>
+
+#define FB_ADDRESS	CONFIG_XNU_FB_BASE
+#define FB_WIDTH	540
+#define FB_HEIGHT	960
+
+int serrano3gxx_init(void)
+{
+	return 0;
+}
+
+/* No serial console: UARTDM clocks are not guaranteed on, and touching a
+ * gated Qualcomm block hangs the CPU. */
+void uart_puts(const char *s)
+{
+	(void)s;
+}
+
+#if FB_ADDRESS
+static struct video_info serrano3gxx_fb = {
+	.format = FB_FORMAT_RGB888,
+	.width = FB_WIDTH,
+	.height = FB_HEIGHT,
+	.stride = 3,
+	.address = (void *)FB_ADDRESS
+};
+
+static const struct device serrano3gxx_devices[] = {
+	{ "simplefb", &serrano3gxx_fb, "fb" },
+};
+#endif
+
+struct board_data board_ops = {
+	.name = "samsung-serrano3gxx",
+	.ops = {
+		.early_init = serrano3gxx_init,
+	},
+#if FB_ADDRESS
+	.devices = serrano3gxx_devices,
+	.num_devices = ARRAY_SIZE(serrano3gxx_devices),
+#else
+	.devices = NULL,
+	.num_devices = 0,
+#endif
+	.quirks = 0
+};

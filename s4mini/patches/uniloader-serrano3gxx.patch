diff --git a/include/soc/msm8930.h b/include/soc/msm8930.h
new file mode 100644
index 0000000..a74c7a6
--- /dev/null
+++ b/include/soc/msm8930.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Qualcomm MSM8930 (Snapdragon 400, Krait) register map for uniLoader.
+ * Addresses from the Samsung/LineageOS msm8930 kernel (msm_iomap-8930.h,
+ * devices-8960.c) and /proc/iomem of a running GT-I9190.
+ */
+
+#ifndef MSM8930_H_
+#define MSM8930_H_
+
+/* Interrupt controller (qGIC) and timers */
+#define MSM8930_QGIC_DIST_BASE		0x02000000
+#define MSM8930_QGIC_CPU_BASE		0x02002000
+#define MSM8930_TMR_BASE		0x0200A000
+#define MSM8930_GPT_OFFSET		0x04
+#define MSM8930_DGT_OFFSET		0x24
+
+/* Display (MDP4 + MIPI DSI) */
+#define MSM8930_MDP_BASE		0x05100000
+#define MSM8930_DSI_BASE		0x04700000
+
+/* Storage: eMMC is SDC1, microSD slot is SDC3 */
+#define MSM8930_SDC1_BASE		0x12400000
+#define MSM8930_SDC3_BASE		0x12180000
+
+/* GSBI / UARTDM (NOT safe to touch unless the bootloader clocked it) */
+#define MSM8930_GSBI5_BASE		0x16400000
+#define MSM8930_UART5DM_BASE		(MSM8930_GSBI5_BASE + 0x40000)
+#define MSM8930_GSBI6_BASE		0x16500000
+#define MSM8930_UART6DM_BASE		(MSM8930_GSBI6_BASE + 0x40000)
+
+#endif /* MSM8930_H_ */

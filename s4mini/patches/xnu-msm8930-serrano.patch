+#define DGT_MATCH_VAL		(DGT_BASE + 0x00U)
+#define DGT_COUNT_VAL		(DGT_BASE + 0x04U)
+#define DGT_ENABLE		(DGT_BASE + 0x08U)
+#define DGT_CLEAR		(DGT_BASE + 0x0CU)
+#define DGT_CLK_CTL		0x34U
+#define DGT_CLK_DIV_4		3U
+#define DGT_EN			1U
+
+#define GIC_DIST_CTRL		0x000U
+#define GIC_DIST_ENABLE_SET	0x100U
+#define GIC_DIST_ENABLE_CLEAR	0x180U
+#define GIC_DIST_PENDING_CLEAR	0x280U
+#define GIC_DIST_PRI		0x400U
+#define GIC_DIST_CONFIG		0xc00U
+#define GIC_CPU_CTRL		0x00U
+#define GIC_CPU_PRIMASK		0x04U
+#define GIC_CPU_INTACK		0x0cU
+#define GIC_CPU_EOI		0x10U
+
+extern void rtc_configure(uint64_t hz);
+extern void rtclock_intr(arm_saved_state_t *regs);
+extern void ios7m8930_fb_flush(void);
+
+uint64_t clock_decrementer;
+static vm_offset_t m_tmr, m_gic_dist, m_gic_cpu;
+static uint32_t controller_ready, timebase_ready, armed;
+static uint32_t last_lo, hi_word;	/* software extension of the 32-bit counter */
+
+static inline uint32_t rd(vm_offset_t b, uint32_t o) { return *(volatile uint32_t *)(b + o); }
+static inline void wr(vm_offset_t b, uint32_t o, uint32_t v) { *(volatile uint32_t *)(b + o) = v; }
+static inline void drain(void) { __asm__ volatile("dsb sy" ::: "memory"); }
+
+/* Callers hold interrupts off. Counter is 32-bit: detect wrap on each read. */
+static uint64_t dgt_get_count(void)
+{
+	uint32_t a, b, lo;
+	do { a = rd(m_tmr, DGT_COUNT_VAL); b = rd(m_tmr, DGT_COUNT_VAL); } while (a != b);
+	lo = b;
+	if (lo < last_lo) hi_word++;
+	last_lo = lo;
+	return ((uint64_t)hi_word << 32) | lo;
+}
+
+void M8930_interrupt_init(void)
+{
+	boolean_t was = ml_set_interrupts_enabled(FALSE);
+	uint32_t i, irq = M8930_DGT_IRQ;
+	if (controller_ready) { ml_set_interrupts_enabled(was); return; }
+	m_gic_dist = ml_io_map(M8930_GIC_DIST_PA, M8930_IO_BYTES);
+	m_gic_cpu  = ml_io_map(M8930_GIC_CPU_PA, M8930_IO_BYTES);
+	if (!m_gic_dist || !m_gic_cpu) panic("M8930 GIC IO mapping failed");
+	/* Disable + clear all, then configure the DGT PPI: mid priority, level. */
+	for (i = 0; i < 8; i++) {
+		wr(m_gic_dist, GIC_DIST_ENABLE_CLEAR + i * 4, 0xffffffffU);
+		wr(m_gic_dist, GIC_DIST_PENDING_CLEAR + i * 4, 0xffffffffU);
+	}
+	wr(m_gic_dist, GIC_DIST_PRI + (irq / 4) * 4,
+	   (rd(m_gic_dist, GIC_DIST_PRI + (irq / 4) * 4) & ~(0xffU << ((irq % 4) * 8))) |
+	   (0x80U << ((irq % 4) * 8)));
+	wr(m_gic_dist, GIC_DIST_CONFIG + (irq / 16) * 4,
+	   rd(m_gic_dist, GIC_DIST_CONFIG + (irq / 16) * 4) & ~(0x3U << ((irq % 16) * 2)));
+	wr(m_gic_dist, GIC_DIST_CTRL, 1U);
+	wr(m_gic_cpu, GIC_CPU_PRIMASK, 0xf0U);
+	wr(m_gic_cpu, GIC_CPU_CTRL, 1U);
+	drain();
+	controller_ready = 1;
+	ml_set_interrupts_enabled(was);
+}
+
+void M8930_timebase_init(void)
+{
+	boolean_t was = ml_set_interrupts_enabled(FALSE);
+	uint64_t a, b;
+	uint32_t i;
+	if (!controller_ready) panic("M8930 timebase before GIC");
+	if (timebase_ready) { ml_set_interrupts_enabled(was); return; }
+	m_tmr = ml_io_map(M8930_TMR_PA, M8930_IO_BYTES);
+	if (!m_tmr) panic("M8930 timer IO mapping failed");
+	wr(m_tmr, DGT_CLK_CTL, DGT_CLK_DIV_4);
+	wr(m_tmr, DGT_ENABLE, 0);		/* stop, no clear-on-match: free-running */
+	wr(m_tmr, DGT_CLEAR, 0);
+	wr(m_tmr, DGT_ENABLE, DGT_EN);
+	drain();
+	last_lo = rd(m_tmr, DGT_COUNT_VAL);
+	hi_word = 0;
+	a = dgt_get_count(); b = a;
+	for (i = 0; i < 65536U; i++) { b = dgt_get_count(); if (b != a) break; }
+	if (a == b) panic("M8930 DGT did not advance");
+	timebase_ready = 1;
+	clock_decrementer = M8930_DGT_HZ / 100U;	/* 10 ms tick */
+	gPEClockFrequencyInfo.timebase_frequency_hz = M8930_DGT_HZ;
+	gPEClockFrequencyInfo.dec_clock_rate_hz = M8930_DGT_HZ;
+	rtc_configure(M8930_DGT_HZ);
+	M8930_timer_enabled(TRUE);
+	ml_set_interrupts_enabled(was);
+}
+
+void M8930_timer_enabled(int enable)
+{
+	boolean_t was = ml_set_interrupts_enabled(FALSE);
+	uint32_t irq = M8930_DGT_IRQ, ticks;
+	uint64_t req = clock_decrementer;
+	if (!timebase_ready) panic("M8930 timer before timebase");
+	if (!enable || req == ~0ULL) {
+		wr(m_gic_dist, GIC_DIST_ENABLE_CLEAR + (irq / 32) * 4, 1U << (irq % 32));
+		armed = 0;
+		ml_set_interrupts_enabled(was);
+		return;
+	}
+	ticks = req > 0x7fffffffU ? 0x7fffffffU : (uint32_t)req;
+	if (ticks < M8930_MIN_MATCH_TICKS) ticks = M8930_MIN_MATCH_TICKS;
+	/* MATCH_VAL is compared against the low 32 bits of COUNT_VAL. */
+	wr(m_tmr, DGT_MATCH_VAL, rd(m_tmr, DGT_COUNT_VAL) + ticks);
+	wr(m_gic_dist, GIC_DIST_PENDING_CLEAR + (irq / 32) * 4, 1U << (irq % 32));
+	wr(m_gic_dist, GIC_DIST_ENABLE_SET + (irq / 32) * 4, 1U << (irq % 32));
+	drain();
+	armed = 1;
+	ml_set_interrupts_enabled(was);
+}
+
+uint64_t M8930_get_timebase(void)
+{
+	uint64_t v;
+	boolean_t w;
+	if (!timebase_ready) return 0;
+	w = ml_set_interrupts_enabled(FALSE);
+	v = dgt_get_count();
+	ml_set_interrupts_enabled(w);
+	return v;
+}
+
+uint64_t M8930_timer_value(void)
+{
+	boolean_t w = ml_set_interrupts_enabled(FALSE);
+	int32_t rem = 0;
+	if (timebase_ready && armed)
+		rem = (int32_t)(rd(m_tmr, DGT_MATCH_VAL) - rd(m_tmr, DGT_COUNT_VAL));
+	ml_set_interrupts_enabled(w);
+	return rem > 0 ? (uint32_t)rem : 0;
+}
+
+void M8930_handle_interrupt(void *context)
+{
+	uint32_t ack, irq, budget;
+	if (!controller_ready || !timebase_ready) panic("M8930 IRQ before init");
+	for (budget = 0; budget < 64U; budget++) {
+		ack = rd(m_gic_cpu, GIC_CPU_INTACK);
+		irq = ack & 0x3ffU;
+		if (irq >= 1020U) return;			/* spurious / none pending */
+		if (irq != M8930_DGT_IRQ) {
+			wr(m_gic_cpu, GIC_CPU_EOI, ack);
+			panic("M8930 unexpected IRQ %u", irq);
+		}
+		wr(m_gic_cpu, GIC_CPU_EOI, ack);
+		drain();
+		(void)dgt_get_count();			/* keep the wrap tracker current */
+		rtclock_intr((arm_saved_state_t *)context);
+		ios7m8930_fb_flush();
+#if !CONFIG_TICKLESS
+		M8930_timer_enabled(TRUE);
+#endif
+	}
+	panic("M8930 IRQ drain budget exceeded");
+}
+#endif /* BOARD_CONFIG_MSM8930_SERRANO */
diff --git a/xnu/pexpert/arm/msm8930_timer.h b/xnu/pexpert/arm/msm8930_timer.h
new file mode 100755
index 0000000..be1fbdc
--- /dev/null
+++ b/xnu/pexpert/arm/msm8930_timer.h
@@ -0,0 +1,26 @@
+/*
+ * MSM8930 (Galaxy S4 mini, serrano3gxx) interrupt controller + DGT timer.
+ * SCAFFOLD: written from the Samsung/LineageOS msm8930 kernel, NOT compiled
+ * or run on hardware yet.
+ */
+#ifndef IOS7LAB_M8930_TIMER_H
+#define IOS7LAB_M8930_TIMER_H
+#include <mach/mach_types.h>
+
+#define M8930_TMR_PA		0x0200A000U	/* GPT at +0x04, DGT at +0x24 */
+#define M8930_GIC_DIST_PA	0x02000000U
+#define M8930_GIC_CPU_PA	0x02002000U
+#define M8930_IO_BYTES		0x1000U
+
+#define M8930_DGT_HZ		6750000U	/* 27 MHz / 4, per Linux timer.c */
+#define M8930_DGT_IRQ		17U		/* PPI 1 (INT_DEBUG_TIMER_EXP) */
+#define M8930_MIN_MATCH_TICKS	16U
+
+void M8930_interrupt_init(void);
+void M8930_timebase_init(void);
+void M8930_handle_interrupt(void *context);
+uint64_t M8930_get_timebase(void);
+uint64_t M8930_timer_value(void);
+void M8930_timer_enabled(int enable);
+extern uint64_t clock_decrementer;
+#endif
diff --git a/xnu/pexpert/arm/pe_msm8930_serrano.c b/xnu/pexpert/arm/pe_msm8930_serrano.c
new file mode 100644
index 0000000..5fc284a
--- /dev/null
+++ b/xnu/pexpert/arm/pe_msm8930_serrano.c
@@ -0,0 +1,425 @@
+/* J1 Exynos3475 PE (Galaxy J1 2016). HD2-architecture adaptation.
+ * Validates loader handoff, maps FB/UART, installs GIC/MCT dispatch,
+ * provides direct-FB display backend (no MDP DMA) and fatal reporter.
+ * Numeric addresses are factual J1 hardware data. */
+#if defined(BOARD_CONFIG_MSM8930_SERRANO)
+#include <mach/mach_types.h>
+#include <mach/host_info.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <pexpert/arm/boot.h>
+#include <pexpert/arm/protos.h>
+#include <pexpert/arm/j1_handoff.h>
+#include <pexpert/arm/j1_entry.h>
+#include "msm8930_timer.h"
+#include <machine/machine_routines.h>
+#include <kern/debug.h>
+#include <kern/clock.h>
+#include <mach/vm_param.h>
+
+extern int switch_to_serial_console(void);
+extern host_t host_self(void);
+extern kern_return_t host_statistics64(host_t host, host_flavor_t flavor,
+                                       host_info64_t info,
+                                       mach_msg_type_number_t *count);
+extern uint64_t sane_size;
+extern unsigned int vm_page_free_count,vm_page_free_reserved,vm_page_free_target;
+
+static volatile unsigned int *j1_pixels;
+/* 32bpp BGRA shadow framebuffer in cached kernel memory; ios7m8930_fb_flush() converts it to the
+ * bootloader's 24bpp RGB888 scanout buffer (540x960, stride 1620) a slice per timer tick. */
+#define M8930_W 540U
+#define M8930_H 960U
+static unsigned int m8930_shadow[M8930_W*M8930_H] __attribute__((aligned(4096)));
+static unsigned int m8930_scan_pa;
+static vm_offset_t m8930_scan_map;
+static unsigned int m8930_flush_row;
+extern boolean_t pmap_initialized;
+void ios7m8930_fb_flush(void)
+{
+ unsigned int y,n;
+ if(!m8930_scan_pa||!j1_pixels) return;
+ if(!m8930_scan_map){
+  if(!pmap_initialized) return;
+  m8930_scan_map=ml_io_map(m8930_scan_pa,0x180000);
+  if(!m8930_scan_map) return;
+ }
+ for(n=0;n<60;n++){
+  const unsigned char *src; volatile unsigned int *dst; unsigned int x;
+  y=m8930_flush_row; if(++m8930_flush_row>=M8930_H) m8930_flush_row=0;
+  src=(const unsigned char *)j1_pixels+y*(M8930_W*4U);
+  dst=(volatile unsigned int *)(m8930_scan_map+y*1620U);
+  for(x=0;x<M8930_W;x+=4){
+   /* 4 BGRA pixels -> 12 bytes R,G,B */
+   unsigned int a=(unsigned int)src[2]|((unsigned int)src[1]<<8)|((unsigned int)src[0]<<16)|((unsigned int)src[6]<<24);
+   unsigned int b=(unsigned int)src[5]|((unsigned int)src[4]<<8)|((unsigned int)src[10]<<16)|((unsigned int)src[9]<<24);
+   unsigned int c=(unsigned int)src[8]|((unsigned int)src[14]<<8)|((unsigned int)src[13]<<16)|((unsigned int)src[12]<<24);
+   dst[0]=a; dst[1]=b; dst[2]=c; dst+=3; src+=16;
+  }
+ }
+}
+static vm_offset_t j1_fb_map;
+static unsigned int j1_fb_physical;
+static volatile unsigned int j1_graphics_owner,j1_fatal_active;
+static unsigned int j1_stage;
+static volatile unsigned int j1_console_count;
+static volatile unsigned int j1_fatal_category;
+static volatile unsigned int j1_fatal_state[8];
+
+void ios7j1_stage(unsigned int n)
+{
+ (void)n;
+}
+static unsigned int j1_callsite(void *r){ return (((unsigned int)r)&~1U)-4U; }
+
+int ios7j1_fatal_report(unsigned int cat, unsigned int cs,
+ unsigned int pc,unsigned int lr,unsigned int far,unsigned int fsr,
+ unsigned int mask,const char *msg)
+{
+ (void)cs;
+ if(j1_fatal_active) return 0;
+ j1_fatal_active=1;
+ if(gPESocDispatch.uart_putc==ios7j1_debug_putc) (void)switch_to_serial_console();
+ j1_fatal_category=cat;
+ j1_fatal_state[0]=cat;j1_fatal_state[1]=j1_stage;
+ j1_fatal_state[2]=mask&15U;j1_fatal_state[3]=pc;
+ j1_fatal_state[4]=lr;j1_fatal_state[5]=far;j1_fatal_state[6]=fsr;
+ return 1;
+}
+void __attribute__((noreturn)) ios7j1_final_boundary(unsigned int reason)
+{
+ if(reason) ios7j1_fatal_report(0xf000U|(reason&0xfffU),
+  j1_callsite(__builtin_return_address(0)),0,0,0,0,0,"ENTRY GUARD");
+ __asm__ volatile("cpsid if" ::: "memory");
+ for(;;) __asm__ volatile("dsb sy\n\twfi" ::: "memory");
+}
+void ios7j1_forget_early_maps(void){ j1_pixels=0; j1_fb_map=0; }
+/* UART S3C @0x13820000: TX-only debug putc (factual offsets).
+ * Before SocSupport maps it, write the physical address directly
+ * (early boot runs identity-mapped); after, use the mapping. */
+#define J1_UART_PA 0x13820000U
+static vm_offset_t j1_uart_map;
+static void j1_uart_putc_phys(char c){ (void)c; }
+static void j1_uart_putc_raw(char c){ (void)c; }
+void ios7j1_debug_putc(char c)
+{
+ if(j1_console_count<1024) j1_console_count++;
+ if(j1_uart_map) j1_uart_putc_raw(c);
+ else j1_uart_putc_phys(c);
+}
+static void j1_puts(const char *s)
+{
+ while(*s) ios7j1_debug_putc(*s++);
+}
+static void j1_puthex(unsigned int v)
+{
+ int i; char h[8];
+ for(i=0;i<8;i++){ unsigned int n=(v>>((7-i)*4))&15U; h[i]=(char)(n<10?('0'+n):('a'+n-10)); }
+ for(i=0;i<8;i++) ios7j1_debug_putc(h[i]);
+}
+/* Early fault reporter for bring-up (called from sleh_abort before any
+ * handling that might itself fault). Lock-free, UART+FB only. */
+static volatile unsigned int j1_flt_n;
+static volatile unsigned int j1_flt_last_pc = 0xffffffffU;
+void ios7j1_fault_report(unsigned int pc,unsigned int lr,unsigned int far,
+                         unsigned int fsr,unsigned int cpsr,unsigned int reason)
+{
+ if(j1_flt_n>=16) {
+  /* Past the detailed window: only report a NEW faulting pc, once, so an
+   * infinite fault loop is diagnosable without flooding the console. */
+  if(pc==j1_flt_last_pc) return;
+  j1_flt_last_pc=pc;
+  j1_puts("J1FLT+ pc=");
+  j1_puthex(pc);
+  j1_puts(" far=");
+  j1_puthex(far);
+  j1_puts(" fsr=");
+  j1_puthex(fsr);
+  j1_puts(" cpsr=");
+  j1_puthex(cpsr);
+  j1_puts(" reason=");
+  j1_puthex(reason);
+  j1_puts("\n");
+  return;
+ }
+ j1_flt_n++;
+ j1_puts("J1FLT n=");
+ j1_puthex(j1_flt_n);
+ j1_puts(" pc=");
+ j1_puthex(pc);
+ j1_puts(" lr=");
+ j1_puthex(lr);
+ j1_puts(" far=");
+ j1_puthex(far);
+ j1_puts(" fsr=");
+ j1_puthex(fsr);
+ j1_puts(" cpsr=");
+ j1_puthex(cpsr);
+ j1_puts(" reason=");
+ j1_puthex(reason);
+ j1_puts("\n");
+}
+void ios7j1_fault_regs(unsigned int r0,unsigned int r1,unsigned int r2,
+                       unsigned int r3)
+{
+ if(j1_flt_n>=16) return;
+ j1_puts("J1REGS r0=");
+ j1_puthex(r0);
+ j1_puts(" r1=");
+ j1_puthex(r1);
+ j1_puts(" r2=");
+ j1_puthex(r2);
+ j1_puts(" r3=");
+ j1_puthex(r3);
+ j1_puts("\n");
+}
+static int j1_getc(void){ return -1; }
+static void j1_uart_init(void){ }
+void ios7j1_kernel_continuing(void){ }
+void ios7j1_timer_observe(unsigned int t,unsigned int c){ (void)t;(void)c; }
+int ios7j1_panic_text_begin(unsigned int r,unsigned int k,unsigned int p){ (void)r;(void)k;(void)p; return 0; }
+void ios7j1_panic_text_putc(char c){ (void)c; }
+void ios7j1_panic_text_end(void){ }
+
+/* Direct-FB backend: 480x800x32 BGRA CPU copy, no DMA (always completed). */
+static uint64_t j1_graphics_seq=1;
+/* Panel text console (fast_putc): active during boot, auto-disabled the moment
+ * the GUI display driver presents its first frame so logs stop clobbering it. */
+volatile int j1_panel_console_enabled=1;
+int ios7j1_display_ready(void)
+{
+ return j1_pixels && !j1_fatal_active &&
+  PE_state.video.v_width==540 && PE_state.video.v_height==960 &&
+  PE_state.video.v_rowBytes==2160 && PE_state.video.v_depth==32;
+}
+int ios7j1_display_present(const uint8_t *px,uint32_t bytes,uint32_t row,
+                           uint32_t fmt,uint64_t *seq)
+{
+ unsigned int y;
+ if(!px||!seq) return 0;
+ if(!(fmt==0x42475241U||fmt==0x52474241U)) return 0;
+ if(row<2160U||bytes<2073600U) return 0;
+ if(!ios7j1_display_ready()) return 0;
+ for(y=0;y<960;y++){
+  const uint8_t *src=px+(uint64_t)y*row;
+  uint8_t *dst=(uint8_t *)j1_pixels+y*2160U;
+  unsigned int i;
+  for(i=0;i<2160U;i++) dst[i]=src[i];
+ }
+ *seq=j1_graphics_seq++;
+ if(!j1_graphics_seq) j1_graphics_seq=1;
+ j1_panel_console_enabled=0;
+ return 1;
+}
+int ios7j1_display_completed(uint64_t s){ return s && s<j1_graphics_seq; }
+
+static int j1_video_ok(const boot_args *a)
+{
+ unsigned long long end=(unsigned long long)a->Video.v_baseAddr+2073600U;
+ unsigned long long ramend=(unsigned long long)a->physBase+a->memSize;
+ return a->Revision==1 && a->Version==2 && a->virtBase==0x80000000U &&
+  a->physBase==0xA6100000U && a->memSize==0x38800000U &&
+  a->topOfKernelData>=a->physBase && !(a->topOfKernelData&0x3fffU) &&
+  (unsigned long long)a->topOfKernelData+0x220000U<=ramend &&
+  a->Video.v_width==540 && a->Video.v_height==960 &&
+  a->Video.v_rowBytes==2160 && a->Video.v_depth==32 &&
+  !(a->Video.v_baseAddr&3U) && a->Video.v_baseAddr==0x88100000U &&
+  end<=(unsigned long long)0x88100000U+0x200000U;
+}
+void ios7j1_checkpoint(boot_args *a, unsigned int stage)
+{
+ if(j1_fatal_active) return;
+ if(stage==6){
+  if(!j1_video_ok(a)) ios7j1_final_boundary(1);
+  m8930_scan_pa=a->Video.v_baseAddr;
+  j1_fb_physical=m8930_scan_pa;
+  j1_pixels=(volatile unsigned int *)m8930_shadow;
+  /* Earliest serial: point dispatch at our putc (physical UART)
+   * so PE_early_puts from here on is visible on the emulator. */
+  gPESocDispatch.uart_putc=ios7j1_debug_putc;
+  gPESocDispatch.uart_getc=j1_getc;
+  gPESocDispatch.uart_init=j1_uart_init;
+  j1_puts("J1 stage6 video ok\n");
+ }
+ if(stage!=j1_stage+1U||stage<6||stage>10){
+  if(!(stage==6&&j1_stage==0)) ios7j1_final_boundary(3);
+ }
+ j1_stage=stage;
+ if(stage==7) j1_puts("J1 stage7\n");
+ else if(stage==8) j1_puts("J1 stage8\n");
+ else if(stage==9) j1_puts("J1 stage9\n");
+ else if(stage==10) j1_puts("J1 stage10\n");
+}
+void PE_init_SocSupport_stub(void)
+{
+ DTEntry chosen;
+ ios7lab_j1_handoff *h=0;
+ unsigned int size=0;
+ boot_args *args=(boot_args *)PE_state.bootArgs;
+ vm_offset_t fb;
+ static ios7lab_j1_handoff j1_default_handoff;
+ if(!j1_video_ok(args)) ios7j1_final_boundary(4);
+ /* Handoff via /chosen when the loader provides it; otherwise synthesize
+  * defaults from boot_args (uniLoader passes physBase/video/top directly). */
+ if(DTLookupEntry(0,"/chosen",&chosen)==kSuccess &&
+    DTGetProperty(chosen,IOS7LAB_J1_DT_PROPERTY,(void **)&h,&size)==kSuccess &&
+    size==128&&h&&h->magic==IOS7LAB_J1_MAGIC&&h->version==1&&
+    h->bytes==128&&h->machine==0x8930U){
+  /* loader-provided handoff accepted as-is */
+ }else{
+  j1_default_handoff.magic=IOS7LAB_J1_MAGIC; j1_default_handoff.version=1;
+  j1_default_handoff.bytes=128; j1_default_handoff.flags=IOS7LAB_J1_FLAGS;
+  j1_default_handoff.machine=0x8930U;
+  j1_default_handoff.disp_physical=0x88100000U;
+  j1_default_handoff.dma_address=args->Video.v_baseAddr;
+  j1_default_handoff.dma_stride=2160; j1_default_handoff.dma_xy=0;
+  j1_default_handoff.width=540; j1_default_handoff.height=960;
+  j1_default_handoff.row_bytes=2160; j1_default_handoff.pixel_format=0x42475241U;
+  j1_default_handoff.framebuffer_bytes=2073600;
+  j1_default_handoff.memory_base=args->physBase;
+  j1_default_handoff.memory_bytes=args->memSize;
+  j1_default_handoff.top_of_kernel_data=args->topOfKernelData;
+  j1_default_handoff.checkpoint_count=5;

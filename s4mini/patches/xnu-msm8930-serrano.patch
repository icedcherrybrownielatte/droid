+  __asm__ volatile("mrc p15,0,%0,c2,c0,0" : "=r"(ttbr0));
+  __asm__ volatile("mrc p15,0,%0,c2,c0,1" : "=r"(ttbr1));
+  __asm__ volatile("mrc p15,0,%0,c2,c0,2" : "=r"(ttcr));

+  j1_puthex(cons_ops[0]);
+  j1_puts(" [1]=");
+  j1_puthex(cons_ops[2]);
+  j1_puts(" n=");
+  j1_puthex(nconsops);
+  j1_puts(" idx=");
+  j1_puthex(cons_ops_index);

+  j1_puts(" ttbr1=");
+  j1_puthex(ttbr1);
+  j1_puts(" ttcr=");
+  j1_puthex(ttcr);
+  j1_puts(" l1=");
+  j1_puthex(l1e);
+  j1_puts(" l2=");
+  j1_puthex(l2e);
+  j1_puts(" pa=");
